# Backend configuration — copy to `.env` and fill in. Never commit the real file.

# Django
DEBUG=True
# Generate one:  python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=True

# Database (SQLite for development, PostgreSQL in production)
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgres://user:password@localhost:5432/ownerconnect

# Redis — Celery broker and the live-chat (Channels) layer. For local development
# you can run without it: start the server with CELERY_TASK_ALWAYS_EAGER=1 and
# everything works except the staff/owner live chat.
REDIS_URL=redis://127.0.0.1:6379/0

# Online payments (Paymob). Leave empty until a merchant account exists —
# the app then shows "card payments not available yet" instead of failing.
PAYMOB_API_KEY=
PAYMOB_IFRAME_ID=
# Signs the payment sessions the webhook trusts. Must differ from SECRET_KEY.
PAYMENT_HMAC_KEY=

# Push notifications + phone/Google sign-in: path to the Firebase Admin service-account JSON
FIREBASE_CREDENTIALS_FILE=

# Development only: lets the mobile app sign in with a "dev test token" for any phone.
# Never enable in production.
ALLOW_DEV_AUTH_BYPASS=0
