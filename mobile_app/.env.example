# Mobile app configuration — copy to `.env` (it is bundled as an asset). Never commit the real file.

# The Django backend. On a real phone use the dev machine's LAN IP, not 127.0.0.1.
API_BASE_URL=http://192.168.1.100:8000
SOCKET_BASE_URL=ws://192.168.1.100:8000/ws

# Reserved for the payment gateway integration
PAYMENT_GATEWAY_KEY=
DEFAULT_RESORT_ID=1

# Web client OAuth id from google-services.json, once Google sign-in is enabled in the Firebase console
GOOGLE_SERVER_CLIENT_ID=
